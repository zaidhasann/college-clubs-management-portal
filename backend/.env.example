# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Database Configuration
# For local development:
MONGODB_URI=mongodb://localhost:27017/club_management
# For MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/club_management?retryWrites=true&w=majority

# JWT Secret for authentication (change in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Razorpay Payment Gateway Keys (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
