# Frontend Environment Variables Example
# Copy this file to .env.local and update values as needed

# API Configuration
# URL for backend API calls
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# For production (Render example):
# NEXT_PUBLIC_API_URL=https://college-clubs-management-portal-3.onrender.com/api

# Application Settings
NEXT_PUBLIC_APP_NAME=College Club Platform
NEXT_PUBLIC_APP_DESCRIPTION=A comprehensive platform for managing college clubs
NODE_ENV=development

# Authentication
NEXT_PUBLIC_AUTH_ENABLED=true

# Feature Flags
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_ATTENDANCE=true

# Deployment Guide:
# 1. For production, update NEXT_PUBLIC_API_URL with your backend domain
# 2. Set NODE_ENV=production for optimized builds
# 3. Ensure all feature flags are set appropriately for your deployment
