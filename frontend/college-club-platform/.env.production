# Frontend Production Environment Variables
# This file should be used for production deployments

# API Configuration
# Production backend URL on Render
NEXT_PUBLIC_API_URL=https://college-clubs-management-portal-3.onrender.com/api

# Application Settings
NEXT_PUBLIC_APP_NAME=College Club Platform
NEXT_PUBLIC_APP_DESCRIPTION=A comprehensive platform for managing college clubs
NODE_ENV=production

# Authentication
NEXT_PUBLIC_AUTH_ENABLED=true

# Feature Flags
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_ATTENDANCE=true
